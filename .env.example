# =============================================================================
# HR-Agent 配置模板（复制为 .env）
# 约定：
#   1) 厂商只配一次 Key/Base（DEEPSEEK_* / DASHSCOPE_*）
#   2) 各步骤用 VENDOR + MODEL 复用 Key，不必重复填 API_KEY
#   3) LLM_* / OPENAI_* 仍为兼容别名（等价于未指定 VENDOR 时的 flat 配置）
# =============================================================================

# ===== Shared =====
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/hr_agent?parseTime=true&charset=utf8mb4
UPLOAD_DIR=./uploads

# ===== Go API =====
GO_HTTP_ADDR=:8080
GO_API_BASE=http://127.0.0.1:8080
PYTHON_AGENT_URL=http://127.0.0.1:8000
MAX_RESCHEDULE=2
REPLY_TIMEOUT_HOURS=48
INTERVIEWER_PACK_HOURS=24
PUBLIC_BASE_URL=http://127.0.0.1:8080
REPLY_TOKEN_SECRET=change-me-reply-secret
HR_API_TOKEN=change-me-hr-token
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# Feishu OAuth login for /admin
FEISHU_LOGIN_ENABLED=true
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/feishu/callback
FEISHU_HR_ALLOW_OPEN_IDS=
FEISHU_HR_ALLOW_EMAILS=

# ===== Mail =====
MAIL_DRY_RUN=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hr@example.com
TEST_CANDIDATE_EMAIL=your_real_email@qq.com
INGRESS_HTTP_ADDR=:8081
INGRESS_MODE=webhook

# ===== LLM 厂商 A：DeepSeek（OpenAI 兼容 Chat）=====
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ===== LLM 厂商 B：DashScope（Chat + Embedding + Rerank 共用 DASHSCOPE_API_KEY）=====
DASHSCOPE_API_KEY=
# Chat（OpenAI 兼容；与 Embedding 可同 Key）
DASHSCOPE_CHAT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen-plus
# Embedding（向量）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
# Rerank（DashScope SDK，仍用 DASHSCOPE_API_KEY）
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2

# ===== 流水线默认（推荐：指定厂商，步骤只改 MODEL）=====
LLM_DEFAULT_VENDOR=deepseek
LLM_DEFAULT_MODEL=deepseek-chat
OFFLINE_MODE=true

# 兼容旧 flat 配置（未设 LLM_DEFAULT_VENDOR 时生效）
# LLM_API_KEY=
# LLM_API_BASE=
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# ===== 各步骤：VENDOR + MODEL（Key 继承厂商块）=====
PARSE_VENDOR=deepseek
PARSE_MODEL=deepseek-chat
SCREEN_VENDOR=deepseek
SCREEN_MODEL=deepseek-chat
QUESTION_VENDOR=deepseek
QUESTION_MODEL=deepseek-chat
CLASSIFY_VENDOR=deepseek
CLASSIFY_MODEL=deepseek-chat
# 单步 override（可选）：PARSE_API_KEY= / PARSE_API_BASE=

# ===== 2.0 双模型解析校验（v2.0-alpha 启用代码；可先配好）=====
# 主解析：PARSE_*（DeepSeek）；校验路：DashScope 另一模型，复用 DASHSCOPE_API_KEY
PARSE_VERIFY_ENABLED=false
PARSE_VERIFY_MODE=dual_llm
PARSE_VERIFY_VENDOR=dashscope
PARSE_VERIFY_MODEL=qwen-plus
# PARSE_HUMAN_IF_INCONSISTENT=true
# PARSE_VERIFY_FIELD_DIFF_THRESHOLD=0.25

# ===== 2.0 三档筛选（Python Agent）=====
SCREEN_TIER_REJECT_MAX=30
SCREEN_TIER_PASS_MIN=60

# ===== Phase 3：Scheduling Agent + scheduling_verify（默认开启）=====
# Go：true=排期前调用 Python /v1/scheduling/assign（规则确定性凑人 → 可选 LLM 精选 → verify）
# false=仅 Phase 2 ResolveAttendees（无 Agent）
SCHEDULING_AGENT_ENABLED=true
SCHEDULING_VENDOR=deepseek
SCHEDULING_MODEL=deepseek-chat
SCHEDULING_LLM_REFINE=true
SCHEDULING_VERIFY_ENABLED=true
# rules=仅规则校验；dual_llm=规则通过后再用校验模型交叉打分（与解析 dual verify 同思路）
SCHEDULING_VERIFY_MODE=dual_llm
SCHEDULING_VERIFY_VENDOR=dashscope
SCHEDULING_VERIFY_MODEL=qwen-plus
# SCHEDULING_VERIFY_SCORE_THRESHOLD=0.75

# ===== Go 运维（2.0）=====
ALERT_WEBHOOK_URL=
IMPORT_CONCURRENCY=2

# ===== 联系方式 / 批量 import（见 docs/CANDIDATE-CONTACT-SCHEME.md）=====
CONTACT_REQUIRE_RESOLVED=true
CONTACT_ALLOW_PLACEHOLDER_IN_DRY_RUN=false
CONTACT_PLACEHOLDER_DOMAINS=import.local
CONTACT_BLOCKLIST_DOMAINS=example.com,test.com,localhost
IMPORT_PRE_EXTRACT=true
IMPORT_DEDUP=skip
# 渠道/ATS：POST /v1/hooks/channel-applications（Header: X-Internal-Token=INTERNAL_API_TOKEN）
# JSON: channel, jd_id, external_id, candidate_name, candidate_email, resume_base64 | resume_path

# ===== RAG =====
RAG_RETRIEVE_K=12
RAG_RERANK_TOP_N=4
CHROMA_PATH=./data/chroma
RAG_COLLECTION=interview_bank
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60

# ===== Agent =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
REACT_MAX_STEPS=4

# ===== LangSmith =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hr-agent

# ===== Calendar / 飞书应用 =====
CALENDAR_PROVIDER=feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 共享看板日历 ID（飞书日历设置里复制；勿用占位符 xxx）
FEISHU_CALENDAR_ID=
FEISHU_USER_ID_TYPE=open_id
FEISHU_TIMEZONE=Asia/Shanghai
FEISHU_LOCATION=飞书会议 / 线上面试
# 通讯录搜人（面试官入库）：开放平台需开通并「发布」通讯录相关读权限
# （如 获取用户基本信息 / 通过手机号或邮箱获取用户 ID / 搜索用户 等，以控制台实际勾选为准）
# 应用可用范围需覆盖目标成员；权限未发布时 GET /v1/admin/feishu/users 会返回明确错误
