# ===== Shared =====
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/hr_agent?parseTime=true&charset=utf8mb4
UPLOAD_DIR=./uploads

# ===== Go API =====
GO_HTTP_ADDR=:8080
GO_API_BASE=http://127.0.0.1:8080
PYTHON_AGENT_URL=http://127.0.0.1:8000
MAX_RESCHEDULE=2
REPLY_TIMEOUT_HOURS=48
PUBLIC_BASE_URL=http://127.0.0.1:8080
REPLY_TOKEN_SECRET=change-me-reply-secret
HR_API_TOKEN=change-me-hr-token
INTERNAL_API_TOKEN=change-me-internal-token
SESSION_SECRET=change-me-session-secret

# Feishu OAuth login for /admin（HR 后台登录，≠ 面试官日历角色）
FEISHU_LOGIN_ENABLED=true
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/feishu/callback
# 可选白名单（逗号分隔）。都留空 = 能打开该飞书应用的用户都可登录
FEISHU_HR_ALLOW_OPEN_IDS=
FEISHU_HR_ALLOW_EMAILS=

# ===== Mail =====
MAIL_DRY_RUN=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hr@example.com
TEST_CANDIDATE_EMAIL=your_real_email@qq.com
INGRESS_HTTP_ADDR=:8081
INGRESS_MODE=webhook

# ===== LLM（默认真源；各步骤可单独覆盖）=====
# 推荐用 LLM_*；OPENAI_* 仍可用作别名（兼容旧配置）
LLM_API_KEY=
LLM_API_BASE=
LLM_DEFAULT_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_API_BASE=
OFFLINE_MODE=true

# 每步：可只改 MODEL；需要不同厂商/账号时再填该步的 API_KEY / API_BASE
PARSE_MODEL=gpt-4o-mini
# PARSE_API_KEY=
# PARSE_API_BASE=
SCREEN_MODEL=gpt-4o-mini
# SCREEN_API_KEY=
# SCREEN_API_BASE=
QUESTION_MODEL=gpt-4o-mini
# QUESTION_API_KEY=
# QUESTION_API_BASE=
CLASSIFY_MODEL=gpt-4o-mini
# CLASSIFY_API_KEY=
# CLASSIFY_API_BASE=

# ===== Embedding / RAG (DashScope) =====
# 优先 DASHSCOPE_API_KEY；也可用 EMBEDDING_API_KEY
DASHSCOPE_API_KEY=
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RAG_RETRIEVE_K=12
RAG_RERANK_TOP_N=4
CHROMA_PATH=./data/chroma
RAG_COLLECTION=interview_bank
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=60

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
REACT_MAX_STEPS=4

# ===== LangSmith =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=hr-agent

# ===== Calendar =====
# memory | feishu
CALENDAR_PROVIDER=feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：已有共享日历 ID；留空则应用自动创建「HR面试排期」日历
FEISHU_CALENDAR_ID=
# 默认面试官（单人兜底；多面试官后续进 DB，不必堆 env）
FEISHU_INTERVIEWER_USER_ID=
FEISHU_INTERVIEWER_NAME=
FEISHU_USER_ID_TYPE=open_id
FEISHU_TIMEZONE=Asia/Shanghai
FEISHU_LOCATION=飞书会议 / 线上面试
